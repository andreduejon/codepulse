{
	"name": "@andreduejon/codepulse",
	"version": "0.11.0",
	"private": true,
	"description": "A terminal git graph visualizer that is read-only by default",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/andreduejon/codepulse.git"
	},
	"keywords": [
		"git",
		"graph",
		"tui",
		"terminal",
		"visualizer",
		"bun",
		"solidjs"
	],
	"type": "module",
	"scripts": {
		"start": "bun run src/index.tsx",
		"build": "bun run scripts/build.ts",
		"test": "bun test",
		"lint": "biome lint src/ tests/ scripts/",
		"format": "biome format src/ tests/ scripts/",
		"check": "biome check src/ tests/ scripts/",
		"check:types": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
		"check:fix": "biome check --write src/ tests/ scripts/"
	},
	"dependencies": {
		"@opentui/core": "0.6.1",
		"@opentui/solid": "0.6.1",
		"solid-js": "1.9.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2"
	}
}
