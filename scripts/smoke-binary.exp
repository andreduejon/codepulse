#!/usr/bin/expect -f

set timeout 30
set binary [lindex $argv 0]
set repository [lindex $argv 1]
stty rows 24 columns 80

set smoke_root "/tmp/codepulse-smoke-[pid]"
file mkdir "$smoke_root/home" "$smoke_root/not-a-repository"
set env(HOME) "$smoke_root/home"
spawn -noecho $binary "$smoke_root/not-a-repository"

expect {
  -re {Enter custom path} {
    send -- "$repository\r"
  }
  timeout {
    catch {close}
    catch {wait}
    file delete -force $smoke_root
    exit 1
  }
}

expect {
  -re {Terminal too small} {
    send -- "q"
  }
  timeout {
    catch {close}
    catch {wait}
    file delete -force $smoke_root
    exit 1
  }
}

expect {
  eof {}
  timeout {
    catch {close}
    catch {wait}
    file delete -force $smoke_root
    exit 1
  }
}

set result [wait]
file delete -force $smoke_root
exit [lindex $result 3]
